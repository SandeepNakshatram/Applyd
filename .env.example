# --- Database (Supabase Postgres) ---
# Use the "Connection pooling" URI from Supabase Project Settings > Database
# for DATABASE_URL, and the direct (non-pooled) URI for DIRECT_URL (used for migrations).
DATABASE_URL="postgresql://postgres:password@localhost:5432/applyd?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/applyd?schema=public"

# --- NextAuth / Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-32-byte-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (Gmail read-only access) ---
# Create in Google Cloud Console > APIs & Services > Credentials.
# Enable the Gmail API. Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# --- Token encryption ---
# 32-byte key, base64-encoded, used to encrypt OAuth tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# --- AI pipeline (Google Gemini) ---
GEMINI_API_KEY="replace-with-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"

# --- Cron ---
# Shared secret required in the Authorization header of /api/cron/sync calls.
CRON_SECRET="replace-with-cron-secret"
